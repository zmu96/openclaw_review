# ───────────────────────────────────────────
# .env.example — 실제 사용 시 .env로 복사 후 값 입력
# Render 배포 시 Environment 탭에 동일한 키/값 등록
# ───────────────────────────────────────────

# ── LLM API (1개 이상 필수) ──────────────────
# 우선순위: Claude → Gemini → Groq
ANTHROPIC_API_KEY=                        # Claude API 키 (1순위, 권장)
CLAUDE_MODEL=claude-haiku-4-5             # 기본값, 변경 불필요

GEMINI_API_KEYS=                          # Gemini API 키 (2순위, 콤마로 여러 개 가능)
GEMINI_MODEL=gemini-2.0-flash             # 기본값, 변경 불필요

GROQ_API_KEY=                             # Groq API 키 (3순위, 폴백)
GROQ_MODEL=llama-3.3-70b-versatile        # 기본값, 변경 불필요

# ── GitHub ───────────────────────────────────
# PR 리뷰 코멘트 게시 + 자동 PR 생성 권한 필요 (repo 스코프)
GITHUB_TOKEN=

# ── Discord ──────────────────────────────────
DISCORD_BOT_TOKEN=

# ── 앱 설정 ──────────────────────────────────
APP_ENV=production                         # development | production
MAX_REPO_SIZE_MB=100
CLONE_BASE_DIR=/tmp/ai-code-reviewer       # Render /tmp 사용 (에페머럴, 재시작 시 초기화)
REPORT_OUTPUT_DIR=/tmp/reports             # Render /tmp 사용

# ── FastAPI 서버 (Render가 PORT를 자동 주입) ──
HOST=0.0.0.0
PORT=8000
