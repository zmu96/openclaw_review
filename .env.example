# ───────────────────────────────────────────
# .env.example — 실제 사용 시 .env로 복사 후 값 입력
# Render 배포 시 Environment 탭에 동일한 키/값 등록
# ───────────────────────────────────────────

# ── Discord ──────────────────────────────────
DISCORD_BOT_TOKEN=

# ── GitHub ───────────────────────────────────
# PR 리뷰 코멘트 게시 + 자동 PR 생성 권한 필요 (repo 스코프)
GITHUB_TOKEN=

# ── Fernet 암호화 키 ─────────────────────────
# 사용자 Anthropic API 키를 암호화 저장할 마스터 키
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 미설정 시 재시작할 때마다 모든 사용자 키가 초기화됨
FERNET_KEY=

# ── LLM 설정 ─────────────────────────────────
# 사용할 Claude 모델 (기본값: claude-haiku-4-5-20251001)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── 웹 UI 전용 (선택) ────────────────────────
# Discord 봇은 사용자 키를 사용하므로 불필요.
# 웹 UI에서 리뷰 기능을 사용할 경우에만 설정.
ANTHROPIC_API_KEY=

# ── 앱 설정 ──────────────────────────────────
APP_ENV=production
MAX_REPO_SIZE_MB=100
CLONE_BASE_DIR=/tmp/prism
REPORT_OUTPUT_DIR=/tmp/reports

# ── FastAPI 서버 (Render가 PORT를 자동 주입) ──
HOST=0.0.0.0
PORT=10000
