# ───────────────────────────────────────────
# .env.example — 실제 사용 시 .env로 복사 후 값 입력
# ───────────────────────────────────────────

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash          # 무료 티어 권장 모델

# GitHub PR 리뷰 (PR 코멘트 게시 권한 필요: repo 스코프)
GITHUB_TOKEN=your_github_token_here

# 디스코드 봇
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 앱 설정
APP_ENV=development                    # development | production
MAX_REPO_SIZE_MB=100                   # 클론 허용 최대 레포 크기
CLONE_BASE_DIR=/tmp/ai-code-reviewer   # 임시 클론 디렉토리 (분석 후 자동 삭제)
REPORT_OUTPUT_DIR=./reports/output     # 리포트 저장 경로

# FastAPI 서버
HOST=0.0.0.0
PORT=8000
